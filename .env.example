APP_NAME=Laravel
APP_ENV=local
APP_SERVICE=autenticacao-api
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=ses-v2
MAIL_FROM_ADDRESS=no-reply@webleap.dev
MAIL_FROM_NAME="Sierra"
SES_CONFIGURATION_SET=webleap-transactional
MAIL_ENFORCE_RECIPIENT_ALLOWLIST=true
MAIL_ALLOWED_RECIPIENTS=albertlimar4@gmail.com
MAIL_ALLOW_SES_SIMULATOR=true

SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
SES_AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ACCESS_TOKEN_TTL_MINUTES=1440
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_LOGO_URL=https://sierra.acadsoft.com.br/logo.png

# SaaS pilot (disabled until central DB, private proxy and tenant storage are configured)
SAAS_ENABLED=false
SAAS_BASE_DOMAIN=sierra.test
SAAS_PLATFORM_HOST=admin.sierra.test
SAAS_SCHEME=https
SAAS_DB_HOST=127.0.0.1
SAAS_DB_PORT=3306
SAAS_DB_DATABASE=sierra_platform
SAAS_DB_USERNAME=
SAAS_DB_PASSWORD=
SAAS_TENANT_DB_HOST=127.0.0.1
SAAS_TENANT_DB_PORT=3306
SAAS_TENANT_DB_USERNAME=
SAAS_TENANT_DB_PASSWORD=
SAAS_STORAGE_ROOT=
SAAS_ASSET_KEY=
SAAS_INTEGRATIONS_FILE=
# Provisioner only; do not give CREATE DATABASE privileges to the web runtime.
SAAS_PROVISION_DB_USERNAME=
SAAS_PROVISION_DB_PASSWORD=
SAAS_INVENTORY_PATH=
SAAS_TRUSTED_PROXIES=

# Optional non-default port for local SaaS URLs
SAAS_URL_PORT=
